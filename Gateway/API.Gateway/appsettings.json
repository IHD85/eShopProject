{
  "ReverseProxy": {
    "Routes": {
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": { "Path": "/basket/{**catch-all}" },
        "RateLimiterPolicy": "fixed",
        "Transforms": [
          { "PathRemovePrefix": "/basket" },
          { "PathPrefix": "/api" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "RateLimiterPolicy": "fixed",
        "Transforms": [
          { "PathRemovePrefix": "/catalog" },
          { "PathPrefix": "/api" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "RateLimiterPolicy": "fixed",
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "PathPrefix": "/api" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/inventory/{**catch-all}" },
        "RateLimiterPolicy": "fixed",
        "Transforms": [
          { "PathRemovePrefix": "/inventory" },
          { "PathPrefix": "/api" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/order/{**catch-all}" },
        "RateLimiterPolicy": "fixed",
        "Transforms": [
          { "PathRemovePrefix": "/order" },
          { "PathPrefix": "/api" }
        ]
      }


    },
    "Clusters": {
      "basket-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "https://basket-api:5001" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "https://catalog-api:5002" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "https://identity-api:5003" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "inventory-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "https://inventory-api:5004" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "order-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "https://order-api:5005" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        }
      }
    }
  }
}
